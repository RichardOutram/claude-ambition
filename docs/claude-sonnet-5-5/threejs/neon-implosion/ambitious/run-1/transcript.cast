[343.48, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mWrote 2 files, ran 2 shell commands\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd \"<workspace>/.ambition/tools\" && W=\"<workspace>\" && T=5.5,6.5,7.5,8.2,8.4,8.5,8.7,9.0,9.5,9.9…\u001b[0m\r\n"]
[361.779, "o", "\r\n\u001b[97m⏺ Now a contact-sheet builder, run for both versions.\u001b[0m\r\n"]
