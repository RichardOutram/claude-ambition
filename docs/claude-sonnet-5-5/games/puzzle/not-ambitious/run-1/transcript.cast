[388.135, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 1 shell command\u001b[0m\u001b[31m · 1 failed\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd <workspace> && sed -i 's/best.slice(0,12)/best/' gen.js && F=\"<workspace>/mirror-twins/index.…\u001b[0m\r\n"]
[391.543, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 2 shell commands\u001b[0m\u001b[31m · 1 failed\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd <workspace> && python3 - <<'E')\u001b[0m\r\n"]
