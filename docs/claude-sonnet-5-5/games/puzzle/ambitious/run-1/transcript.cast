[288.15, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 2 shell commands\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd \"<workspace>/.ambition/tools\" && cp levels.json levels_main.json && sed -i.bak 's/const out=\\…\u001b[0m\r\n"]
[396.823, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 3 shell commands\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd \"<workspace>/.ambition/tools\" && node -e \")\u001b[0m\r\n"]
