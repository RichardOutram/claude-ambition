[103.682, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 2 shell commands\u001b[0m\r\n\u001b[90m  ⎿  Bash(mkdir -p \"<workspace>/.ambition/tools\" && cd \"<workspace>/.ambition/tools\" && npm init -y >/dev/…\u001b[0m\r\n"]
