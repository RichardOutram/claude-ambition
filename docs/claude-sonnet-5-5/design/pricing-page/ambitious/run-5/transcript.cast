[64.489, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 2 shell commands, edited 5 files\u001b[0m\u001b[31m · 1 failed\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd /tmp && C=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"; F=\"file://<workspac…\u001b[0m\r\n"]
