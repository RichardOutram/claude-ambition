[78.325, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 2 shell commands, read 1 file\u001b[0m\r\n\u001b[90m  ⎿  Read(/tmp/d.png)\u001b[0m\r\n"]
