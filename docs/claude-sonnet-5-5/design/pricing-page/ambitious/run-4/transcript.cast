[113.18, "o", "\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[32m⏺\u001b[0m \u001b[1mRan 4 shell commands, read 3 files\u001b[0m\u001b[31m · 1 failed\u001b[0m\r\n\u001b[90m  ⎿  Bash(cd \"<workspace>\" && python3 -I - <<'EOF')\u001b[0m\r\n"]
